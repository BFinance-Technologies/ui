  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.0.0",
    "vite": "^5.4.1"
  },
  "dependencies": {
    "@bfinance/icons": "^1.0.2"
  }
}
